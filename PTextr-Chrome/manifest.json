{
    "manifest_version": 3,
    "name": "PTextr",
    "version": "1.0.0",
    "description": "Transform text using AI commands.",
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://ptextr.onrender.com/*",
        "http://127.0.0.1:8000/*",
        "http://*/*",
        "https://*/*"
    ],
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "all_frames": true,
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}